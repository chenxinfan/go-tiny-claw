# 复制本文件为 .env，填上真实 key 即可；.env 已被 .gitignore 忽略，不会进仓库。
#
# PowerShell: Copy-Item .env.example .env
# macOS/Linux: cp .env.example .env

# 必填：DeepSeek 控制台申请的 API Key
DEEPSEEK_API_KEY=sk-your-key-here

# 可选：默认 deepseek-chat（非思考模式）；换成 deepseek-reasoner 即思考模式
# DEEPSEEK_MODEL=deepseek-chat

# 可选：自建网关 / 代理时改这里，默认官方地址
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/

# 可选（第 09 章）：飞书机器人。四个都填了才会以 Webhook 服务模式启动，
# 否则走本地命令行 demo（终端 Reporter）。
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# FEISHU_VERIFY_TOKEN=xxx
# FEISHU_ENCRYPT_KEY=xxx
